# XIAO ESP32-S3 on the ReSpeaker XVF3800 board; 8 MB flash configuration.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# No console at all: GPIO43/44 (U0TXD/U0RXD) are the I2S data lines to the
# XMOS, and the USB PHY belongs to the OTG controller (TinyUSB), not to
# USB-Serial-JTAG. Logs go to a RAM ring read via the CDC "log" command.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
