(text "XIAO modules plug into fourteen edge contacts. Bottom pads and fine-pitch interfaces are not silently connected." (at 12.7 248 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid 4b4375f6-af95-5761-8e6d-b86a47cb107a))
