				)
			)
		)
		(property "Verification" "JST XH 2.50mm PCB male header; short cable connection selected by user. Motherboard mate XHP-2 + SXH-001T-P0.6. Use the actual UPS supplied mating plug on the UPS end; vendor phrase XH2.54 is not the PCB pitch specification. Existing pin-to-net allocation retained; qualify cable polarity and total current. Panel START contact only, not a fifth UPS port. Momentary normally-open button parallels M16 COM/NO; carries startup current. Placed in the rear connector bank, clear of the airflow corridor."
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "933d5c02-f56c-4a29-8543-5626eefeb672")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
		(property "Rating" "3 A AC/DC with AWG22 per JST XH; not a 5 A connector rating"
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "948cfc6f-a8f6-4685-aa09-4506ceff17b3")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
			)
		)
		(property "BOM Comments" "Fifth header is external momentary START, behind ZERO. Not connected to a fifth UPS port. This is a battery switch loop: neither switch pin is GND. Momentary NO panel switch carries startup current; exact DC/inrush rating remains unmeasured."
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
